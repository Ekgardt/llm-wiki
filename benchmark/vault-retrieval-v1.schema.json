{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/vault-retrieval-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "schema_version", "thresholds", "cases"],
  "properties": {
    "corpus_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "vault-retrieval/v1"},
    "note": {"type": "string", "maxLength": 500},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_hit_at_5", "min_gain_over_grep_at_5"],
      "properties": {
        "min_hit_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "min_gain_over_grep_at_5": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "question", "gold_path"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
          "question": {"type": "string", "minLength": 5, "maxLength": 300},
          "gold_path": {"type": "string", "minLength": 5, "maxLength": 300}
        }
      }
    }
  }
}
