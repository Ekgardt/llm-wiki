{"$id":"https://llm-wiki.local/schemas/retrieval-v2.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Closed public synthetic retrieval and QA corpus. Metrics follow TREC/ir-measures definitions: Recall@k is the fraction of known relevant evidence retrieved, MRR@10 uses the first relevant rank, and nDCG@10 uses graded gains with log2 discount normalized by the ideal ranking. See https://ir-measur.es/en/latest/measures.html.","properties":{"corpus_id":{"enum":["public-synthetic-retrieval-v2","public-synthetic-retrieval-v2-crosslingual"]},"description":{"maxLength":500,"minLength":20,"type":"string"},"documents":{"items":{"additionalProperties":false,"properties":{"evidence_spans":{"items":{"additionalProperties":false,"properties":{"byte_end":{"maximum":1000000,"minimum":1,"type":"integer"},"byte_start":{"maximum":1000000,"minimum":0,"type":"integer"},"evidence_id":{"pattern":"^[a-z0-9][a-z0-9-]{2,63}$","type":"string"},"heading_path":{"items":{"maxLength":100,"minLength":1,"type":"string"},"maxItems":6,"minItems":1,"type":"array"},"span_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"text":{"maxLength":1000,"minLength":1,"type":"string"}},"required":["evidence_id","heading_path","text","byte_start","byte_end","span_sha256"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"language":{"enum":["EN","RU","ZH"]},"parent_id":{"pattern":"^[a-z0-9][a-z0-9-]{2,63}$","type":"string"},"parent_text":{"maxLength":4000,"minLength":10,"type":"string"},"project":{"pattern":"^[a-z0-9][a-z0-9-]{1,31}$","type":"string"},"relative_path":{"maxLength":160,"pattern":"^synthetic/[a-z0-9/-]+\\.md$","type":"string"},"status":{"enum":["active","superseded"]},"superseded_by":{"oneOf":[{"pattern":"^[a-z0-9][a-z0-9-]{2,63}$","type":"string"},{"type":"null"}]},"valid_from":{"pattern":"^20[0-9]{2}-[0-9]{2}-[0-9]{2}$","type":"string"},"valid_to":{"oneOf":[{"pattern":"^20[0-9]{2}-[0-9]{2}-[0-9]{2}$","type":"string"},{"type":"