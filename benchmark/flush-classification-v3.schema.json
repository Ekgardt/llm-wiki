{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/flush-classification-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "schema_version", "thresholds", "cases"],
  "properties": {
    "corpus_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "flush-classification/v3"},
    "source": {"type": "string", "maxLength": 200},
    "built_at": {"type": "string", "maxLength": 64},
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "contested"],
      "properties": {
        "confirmed": {"type": "integer", "minimum": 0},
        "contested": {"type": "integer", "minimum": 0},
        "kappa": {"type": ["number", "null"]}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_accuracy", "durable_content_recall", "false_promotion_rate"],
      "properties": {
        "tier_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "durable_content_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "false_promotion_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "language",
          "event",
          "content_classes",
          "transcript",
          "expected_tier",
          "required_markers",
          "label_provenance",
          "label_status",
          "readings"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
          "language": {"type": "string", "enum": ["EN", "RU", "ZH"]},
          "event": {"type": "string", "enum": ["session-end", "pre-compact"]},
          "content_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["decision", "lesson", "command", "gotcha", "question"]}
          },
          "transcript": {"type": "string", "minLength": 1, "maxLength": 61000},
          "expected_tier": {"type": "string", "enum": ["major", "minor", "ok"]},
          "required_markers": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "canned_response": {"type": "string", "maxLength": 4000},
          "label_provenance": {"type": "string", "enum": ["readings"]},
          "label_status": {"type": "string", "enum": ["confirmed", "contested"]},
          "readings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rubric", "quote", "passage"],
            "properties": {
              "rubric": {"type": "string", "enum": ["major", "minor", "ok"]},
              "quote": {"type": ["string", "null"], "enum": ["major", "minor", "ok", null]},
              "passage": {"type": "string", "maxLength": 1000}
            }
          }
        }
      }
    }
  }
}
