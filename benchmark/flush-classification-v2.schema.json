{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/flush-classification-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "schema_version", "thresholds", "cases"],
  "properties": {
    "corpus_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "flush-classification/v2"},
    "source": {"type": "string", "maxLength": 200},
    "built_at": {"type": "string", "maxLength": 64},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_accuracy", "durable_content_recall", "false_promotion_rate"],
      "properties": {
        "tier_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "durable_content_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "false_promotion_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "language",
          "event",
          "content_classes",
          "transcript",
          "expected_tier",
          "required_markers",
          "label_provenance",
          "label_reviewed"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
          "language": {"type": "string", "enum": ["EN", "RU", "ZH"]},
          "event": {"type": "string", "enum": ["session-end", "pre-compact"]},
          "content_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["decision", "lesson", "command", "gotcha", "question"]}
          },
          "transcript": {"type": "string", "minLength": 1, "maxLength": 60000},
          "expected_tier": {"type": "string", "enum": ["major", "minor", "ok"]},
          "required_markers": {
            "type": "array",
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "canned_response": {"type": "string", "maxLength": 4000},
          "label_provenance": {"type": "string", "enum": ["human", "judge"]},
          "label_reviewed": {"type": "boolean"},
          "human_tier": {"type": "string", "enum": ["major", "minor", "ok"]}
        }
      }
    }
  }
}
