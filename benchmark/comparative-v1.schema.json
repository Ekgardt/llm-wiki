{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/comparative-v1.json",
  "type": "object",
  "required": ["adapters", "availability", "fairness", "metrics", "provenance", "public_claim_gate", "schema_version", "smoke", "statistics", "tasks"],
  "properties": {
    "adapters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "implementation_status", "input_contract", "output_contract"],
        "properties": {
          "id": {"enum": ["grep-read", "graphify-pinned", "llm-wiki-current", "evidence-graph-only", "hybrid-retrieval", "adaptive-context-compiler"]},
          "implementation_status": {"const": "contract-only"},
          "input_contract": {"const": "comparative-adapter-input/v1"},
          "output_contract": {"const": "comparative-task-ledger/v1"}
        },
        "additionalProperties": false
      }
    },
    "availability": {
      "type": "object",
      "required": ["gate_f_passed", "heavy_comparison_available", "reason"],
      "properties": {
        "gate_f_passed": {"const": false},
        "heavy_comparison_available": {"const": false},
        "reason": {"type": "string", "minLength": 20, "maxLength": 300}
      },
      "additionalProperties": false
    },
    "fairness": {
      "type": "object",
      "required": ["enforcement", "identical_inputs"],
      "properties": {
        "enforcement": {"const": "reject-run-on-any-mismatch"},
        "identical_inputs": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["repository", "commit", "hardware", "task", "model", "context_budget", "retry_policy"]}
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["latency_summary", "per_task_fields", "unavailable_value"],
      "properties": {
        "latency_summary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["p50", "p95"]}
        },
        "per_task_fields": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {"enum": ["executable_task_success", "blinded_factual_correctness", "retrieval_quality", "uncached_input_tokens", "uncached_output_tokens", "cache_tokens", "indexing_time_ms", "incremental_time_ms", "query_latency_ms", "peak_ram_bytes", "index_size_bytes", "edge_precision", "edge_recall", "freshness"]}
        },
        "unavailable_value": {"const": null}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["configuration", "dependencies", "graphify", "model", "python", "tokenizer"],
      "properties": {
        "configuration": {
          "type": "object",
          "required": ["id", "sha256"],
          "properties": {
            "id": {"const": "comparative-smoke-v1"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string"}
        },
        "graphify": {
          "type": "object",
          "required": ["commit", "dependency_lock", "repository"],
          "properties": {
            "commit": {"const": "cb96bdaa0c367bec8d5c5aee5d7c9ebb727e9780"},
            "dependency_lock": {
              "type": "object",
              "required": ["git_blob_sha1", "path"],
              "properties": {
                "git_blob_sha1": {"const": "088ebbbdcb17eacec5b60541f290381f6adf33e7"},
                "path": {"const": "uv.lock"}
              },
              "additionalProperties": false
            },
            "repository": {"const": "https://github.com/Graphify-Labs/graphify"}
          },
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "required": ["id", "provider", "revision"],
          "properties": {
            "id": {"const": "deterministic-fake/comparative-v1"},
            "provider": {"const": "offline-fake"},
            "revision": {"const": "comparative-smoke-v1"}
          },
          "additionalProperties": false
        },
        "python": {
          "type": "object",
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"const": "CPython"},
            "version": {"const": "3.12.10"}
          },
          "additionalProperties": false
        },
        "tokenizer": {
          "type": "object",
          "required": ["id", "revision"],
          "properties": {
            "id": {"const": "utf8-bytes/v1"},
            "revision": {"const": "comparative-smoke-v1"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "public_claim_gate": {
      "type": "object",
      "required": ["comparisons", "consumed_report_fields", "hard_gates", "quality_lower_bound_basis_points_strictly_greater_than", "requires_gate_f", "requires_real_evidence", "token_ratio_upper_bound_basis_points_strictly_less_than"],
      "properties": {
        "comparisons": {
          "type": "object",
          "required": ["quality", "token_ratio"],
          "properties": {
            "quality": {"const": "10000*quality_difference_lower_confidence_bound>-200"},
            "token_ratio": {"const": "10000*token_ratio_upper_confidence_bound<9000"}
          },
          "additionalProperties": false
        },
        "consumed_report_fields": {
          "type": "object",
          "required": ["quality", "token_ratio"],
          "properties": {
            "quality": {"const": "quality_difference_lower_confidence_bound"},
            "token_ratio": {"const": "token_ratio_upper_confidence_bound"}
          },
          "additionalProperties": false
        },
        "hard_gates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["evidence", "freshness", "crash"]}
        },
        "quality_lower_bound_basis_points_strictly_greater_than": {"const": -200},
        "requires_gate_f": {"const": true},
        "requires_real_evidence": {"const": true},
        "token_ratio_upper_bound_basis_points_strictly_less_than": {"const": 9000}
      },
      "additionalProperties": false
    },
    "schema_version": {"const": "comparative-contract/v1"},
    "smoke": {
      "type": "object",
      "required": ["adapter_kind", "attempts_per_adapter", "intentional_failure_adapter", "max_adapters", "max_tasks", "network_access"],
      "properties": {
        "adapter_kind": {"const": "deterministic-fake"},
        "attempts_per_adapter": {"const": 1},
        "intentional_failure_adapter": {"const": "graphify-pinned"},
        "max_adapters": {"const": 6},
        "max_tasks": {"const": 1},
        "network_access": {"const": false}
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "required": ["agent_seeds", "claim_gating_method", "estimands", "guidance", "interval", "missing_and_failures", "pairing", "randomization_diagnostic", "resampling", "rng"],
      "properties": {
        "agent_seeds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        },
        "claim_gating_method": {"const": "paired-hierarchical-percentile-bootstrap"},
        "estimands": {
          "type": "object",
          "required": ["quality_difference", "token_ratio"],
          "properties": {
            "quality_difference": {
              "type": "object",
              "required": ["baseline", "candidate", "formula", "scale"],
              "properties": {
                "baseline": {"const": "same score for pinned Graphify"},
                "candidate": {"const": "terminal executable success when graded, otherwise blinded factual correctness"},
                "formula": {"const": "equal-weight mean over pairing keys of matched-seed mean(candidate-baseline)"},
                "scale": {"const": "proportion-points"}
              },
              "additionalProperties": false
            },
            "token_ratio": {
              "type": "object",
              "required": ["formula", "per_attempt_total", "retry_accounting", "scale"],
              "properties": {
                "formula": {"const": "sum(candidate attempt totals)/sum(pinned Graphify attempt totals) over the resample"},
                "per_attempt_total": {"const": "uncached_input_tokens+uncached_output_tokens+cache_tokens"},
                "retry_accounting": {"const": "include every attempted retry"},
                "scale": {"const": "ratio"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "guidance": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "pattern": "^https://"}
        },
        "interval": {
          "type": "object",
          "required": ["construction", "familywise_confidence_level_basis_points", "per_estimand_one_sided_confidence_level_basis_points", "quality_quantile_basis_points", "quality_tail", "token_ratio_quantile_basis_points", "token_ratio_tail"],
          "properties": {
            "construction": {"const": "percentile"},
            "familywise_confidence_level_basis_points": {"const": 9500},
            "per_estimand_one_sided_confidence_level_basis_points": {"const": 9750},
            "quality_quantile_basis_points": {"const": 250},
            "quality_tail": {"const": "lower"},
            "token_ratio_quantile_basis_points": {"const": 9750},
            "token_ratio_tail": {"const": "upper"}
          },
          "additionalProperties": false
        },
        "missing_and_failures": {
          "type": "object",
          "required": ["failed_attempt_tokens", "failed_terminal_quality", "missing_expected_ledger", "missing_quality_metric", "missing_token_metric", "zero_graphify_token_denominator"],
          "properties": {
            "failed_attempt_tokens": {"const": "include observed consumption"},
            "failed_terminal_quality": {"const": "zero"},
            "missing_expected_ledger": {"const": "invalidate evidence and close public gate"},
            "missing_quality_metric": {"const": "invalidate quality bound and close public gate"},
            "missing_token_metric": {"const": "invalidate token bound and close public gate"},
            "zero_graphify_token_denominator": {"const": "invalidate token bound and close public gate"}
          },
          "additionalProperties": false
        },
        "pairing": {
          "type": "object",
          "required": ["key", "require_identical_seed_sets", "seed_role"],
          "properties": {
            "key": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"enum": ["repository", "commit", "task"]}
            },
            "require_identical_seed_sets": {"const": true},
            "seed_role": {"const": "matched-repeated-run"}
          },
          "additionalProperties": false
        },
        "randomization_diagnostic": {
          "type": "object",
          "required": ["confidence_set_inversion", "gating", "interpretation", "method", "tail"],
          "properties": {
            "confidence_set_inversion": {"const": false},
            "gating": {"const": false},
            "interpretation": {"const": "diagnostic-p-value-only"},
            "method": {"const": "paired-sign-flip-on-cluster-quality-differences"},
            "tail": {"const": "two-sided"}
          },
          "additionalProperties": false
        },
        "resampling": {
          "type": "object",
          "required": ["candidate_baseline_pairing", "cluster_aggregation", "cluster_level", "resamples", "within_cluster_level"],
          "properties": {
            "candidate_baseline_pairing": {"const": "same-cluster-occurrences-and-seed-indices"},
            "cluster_aggregation": {"const": "equal-weight-mean"},
            "cluster_level": {"const": "resample-pairing-keys-with-replacement"},
            "resamples": {"const": 10000},
            "within_cluster_level": {"const": "resample-matched-seed-indices-with-replacement"}
          },
          "additionalProperties": false
        },
        "rng": {
          "type": "object",
          "required": ["algorithm", "bootstrap_seed_hex", "randomization_seed_hex"],
          "properties": {
            "algorithm": {"const": "sha256-counter-v1"},
            "bootstrap_seed_hex": {"const": "8f507f48dc6f8f5a73ec78f7d58f3cf4"},
            "randomization_seed_hex": {"const": "299f31ed0b43d65e46945f85e51b9def"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "inputs"],
        "properties": {
          "id": {"const": "smoke-contract-001"},
          "inputs": {
            "type": "object",
            "required": ["commit", "context_budget", "hardware", "model", "repository", "retry_policy", "task"],
            "properties": {
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "context_budget": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "hardware": {"type": "string", "minLength": 3, "maxLength": 100},
              "model": {"const": "deterministic-fake/comparative-v1@comparative-smoke-v1"},
              "repository": {"const": "synthetic://comparative-smoke-v1"},
              "retry_policy": {
                "type": "object",
                "required": ["backoff", "max_attempts"],
                "properties": {
                  "backoff": {"const": "none"},
                  "max_attempts": {"const": 1}
                },
                "additionalProperties": false
              },
              "task": {"type": "string", "minLength": 20, "maxLength": 300}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
