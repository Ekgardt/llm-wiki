{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/lift-attribution-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "schema_version", "inherited", "thresholds", "cases"],
  "properties": {
    "corpus_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "lift-attribution/v1"},
    "note": {"type": "string", "maxLength": 2000},
    "inherited": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus", "stratum"],
      "properties": {
        "corpus": {"type": "string", "minLength": 1},
        "stratum": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_harm_rate", "noise_floor_points"],
      "properties": {
        "max_harm_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "noise_floor_points": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "stratum",
          "question",
          "expected_tokens",
          "collision_probes",
          "gold_command",
          "gold_evidence"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"},
          "stratum": {"enum": ["world"]},
          "question": {"type": "string", "minLength": 5, "maxLength": 300},
          "expected_tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1, "maxLength": 60}
          },
          "forbidden_tokens": {
            "type": "array",
            "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 60}
          },
          "collision_probes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 2, "maxLength": 60}
          },
          "gold_command": {"type": "string", "minLength": 3, "maxLength": 400},
          "gold_evidence": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    }
  }
}
