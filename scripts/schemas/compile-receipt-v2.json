{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/compile-receipt-v2.json",
  "type": "object",
  "required": ["schema_version", "source_digest", "input_digests", "action_key", "state", "completed_at", "operation_id", "operations", "evidence"],
  "properties": {
    "schema_version": {"const": "compile-receipt/v2"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_digests": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "action_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"const": "completed"},
    "completed_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "operations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["kind", "path", "after_sha256"],
        "properties": {
          "kind": {"enum": ["create", "replace"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 3200,
      "items": {
        "type": "object",
        "required": ["operation_path", "source_path", "source_digest", "quote_sha256"],
        "properties": {
          "operation_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
