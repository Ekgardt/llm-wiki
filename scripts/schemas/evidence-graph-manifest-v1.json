{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/evidence-graph-manifest-v1.json",
  "type": "object",
  "required": ["generation_id", "schema_version", "collector_version", "extractor_version", "tokenizer_version", "tokenizer_config_sha256", "embedding_model_id", "embedding_model_revision", "vector_dimensions", "graph_schema_version", "graph_extractor_version", "source_manifest_sha256", "artifacts", "vector_state"],
  "properties": {
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "parent_generation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "schema_version": {"enum": ["corpus-generation/v1", "corpus-generation/v2"]},
    "collector_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "extractor_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "tokenizer_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "tokenizer_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "embedding_model_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "embedding_model_revision": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "vector_dimensions": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 65536}]},
    "graph_schema_version": {"oneOf": [{"type": "null"}, {"enum": ["evidence-graph/v2", "evidence-graph/v3"]}]},
    "graph_extractor_version": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_capture": {
      "type": "object",
      "required": ["policy", "limits", "files", "directories", "membership_sha256"],
      "properties": {
        "policy": {
          "type": "object",
          "required": ["roots", "include_globs", "ignore_globs", "suffixes"],
          "properties": {
            "roots": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
            "include_globs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
            "ignore_globs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
            "suffixes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\.[^/\\\\]+$"}}
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": ["max_files", "max_file_bytes", "max_total_bytes", "max_entries", "max_directories", "max_depth", "chunk_bytes"],
          "properties": {
            "max_files": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
            "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 17179869184},
            "max_entries": {"type": "integer", "minimum": 1, "maximum": 5000000},
            "max_directories": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "max_depth": {"type": "integer", "minimum": 1, "maximum": 256},
            "chunk_bytes": {"type": "integer", "minimum": 4096, "maximum": 8388608}
          },
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "required": ["source_id", "relative_path", "sha256", "stat"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1, "maxLength": 512},
              "relative_path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "stat": {
                "type": "object",
                "required": ["size", "mtime_ns", "ctime_ns", "mode", "device", "inode"],
                "properties": {
                  "size": {"type": "integer", "minimum": 0, "maximum": 1073741824},
                  "mtime_ns": {"type": "integer", "minimum": 0},
                  "ctime_ns": {"type": "integer", "minimum": 0},
                  "mode": {"type": "integer", "minimum": 0},
                  "device": {"type": "integer", "minimum": 0},
                  "inode": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "directories": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "object",
            "required": ["relative_path", "entry_count", "entries_sha256"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "entry_count": {"type": "integer", "minimum": 0, "maximum": 5000000},
              "entries_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "membership_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "repository_scope": {
      "type": "object",
      "required": ["schema_version", "repository_id", "checkout_id", "checkout_root", "git_common_dir", "git_commit"],
      "properties": {
        "schema_version": {"const": "repository-scope/v1"},
        "repository_id": {"type": "string", "pattern": "^repository:[0-9a-f]{64}$"},
        "checkout_id": {"type": "string", "pattern": "^checkout:[0-9a-f]{64}$"},
        "checkout_root": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:/(?!/)(?:(?!\\.{1,2}(?:/|$))[^/\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000\\r\\n]+)*)?|[A-Z]:/(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+)*)?)$"},
        "git_common_dir": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:/(?!/)(?:(?!\\.{1,2}(?:/|$))[^/\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000\\r\\n]+)*)?|[A-Z]:/(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+)*)?)$"}
          ]
        },
        "git_commit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["git_common_dir", "git_commit"],
          "properties": {
            "git_common_dir": {"type": "string"},
            "git_commit": {"type": ["null", "string"]}
          }
        },
        {
          "type": "object",
          "required": ["git_common_dir", "git_commit"],
          "properties": {
            "git_common_dir": {"type": "null"},
            "git_commit": {"type": "null"}
          }
        }
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "size": {"type": "integer", "minimum": 0, "maximum": 17179869184},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "vector_state": {"enum": ["absent", "complete", "stale"]}
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": "corpus-generation/v1"},
        "graph_schema_version": {"oneOf": [{"type": "null"}, {"const": "evidence-graph/v2"}]}
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "repository_scope"],
      "properties": {
        "schema_version": {"const": "corpus-generation/v2"},
        "graph_schema_version": {"enum": ["evidence-graph/v2", "evidence-graph/v3"]},
        "graph_extractor_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifacts": {
          "contains": {"properties": {"path": {"const": "source-manifest.json"}}, "required": ["path"]},
          "allOf": [
            {"contains": {"properties": {"path": {"const": "evidence.sqlite3"}}, "required": ["path"]}},
            {"contains": {"properties": {"path": {"const": "search.sqlite3"}}, "required": ["path"]}}
          ],
          "items": {
            "properties": {
              "path": {
                "enum": ["source-manifest.json", "evidence.sqlite3", "search.sqlite3", "incremental-manifest.json", "vectors.npy", "vectors.json"]
              }
            }
          }
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"graph_schema_version": {"const": "evidence-graph/v3"}}, "required": ["graph_schema_version"]},
      "then": {"required": ["code_capture"]}
    }
  ]
}
