{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/grounded-answer-v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "claims",
    "citations",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "grounded-answer/v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "insufficient_evidence",
        "conflicting_evidence",
        "unsupported_time_scope"
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "text",
          "citation_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "citation_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^E[1-9][0-9]*$"
            }
          },
          "derivation": {
            "description": "How this claim was computed from the spans it cites, when no span states it: a sum, a count, a difference between two dates or figures, or the latest of several values. Omitted for a claim that one cited span carries on its own.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "enum": [
                  "sum",
                  "count",
                  "difference",
                  "latest"
                ]
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      ]
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "citation_id",
        "relative_path",
        "source_sha256",
        "revision",
        "byte_start",
        "byte_end",
        "line_start",
        "line_end",
        "span_sha256"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "pattern": "^E[1-9][0-9]*$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "span_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
