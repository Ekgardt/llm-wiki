{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/capture-intent-v1.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_text": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "maxLength": 4096}
      ]
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "intent_id",
    "source_occurrence_id",
    "source_event_id",
    "occurred_at",
    "host",
    "event",
    "session",
    "project_slug",
    "worktree",
    "trigger",
    "checkpoint_reason",
    "chunk_index",
    "chunk_count",
    "evidence",
    "complete_input_sha256",
    "chunk_sha256"
  ],
  "properties": {
    "schema_version": {"const": "capture-intent/v1"},
    "intent_id": {"$ref": "#/$defs/digest"},
    "source_occurrence_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_event_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "occurred_at": {"$ref": "#/$defs/nullable_text"},
    "host": {"type": "string", "minLength": 1, "maxLength": 64},
    "event": {"enum": ["session_end", "pre_compact"]},
    "session": {"$ref": "#/$defs/nullable_text"},
    "project_slug": {"$ref": "#/$defs/nullable_text"},
    "worktree": {"$ref": "#/$defs/nullable_text"},
    "trigger": {"$ref": "#/$defs/nullable_text"},
    "checkpoint_reason": {"$ref": "#/$defs/nullable_text"},
    "chunk_index": {"type": "integer", "minimum": 0, "maximum": 7},
    "chunk_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["role", "parts"],
        "properties": {
          "role": {"type": "string", "minLength": 1, "maxLength": 64},
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": {"const": "text"},
                "text": {"type": "string", "minLength": 1, "maxLength": 1048576}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "complete_input_sha256": {"$ref": "#/$defs/digest"},
    "chunk_sha256": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false
}
