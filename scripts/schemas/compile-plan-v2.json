{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/compile-plan-v2.json",
  "type": "object",
  "required": ["schema_version", "operations"],
  "properties": {
    "schema_version": {"const": "compile-plan/v2"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "content"],
        "properties": {
          "kind": {"enum": ["create", "replace", "delete"]},
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
