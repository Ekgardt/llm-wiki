{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/queue-task-v2.json",
  "type": "object",
  "required": ["schema_version", "task_id", "kind", "handler_version", "payload", "input_hash", "state", "priority", "attempts"],
  "properties": {
    "schema_version": {"const": "queue-task/v2"},
    "task_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "handler_version": {"type": "string", "minLength": 1},
    "payload": {"type": "object", "properties": {}, "additionalProperties": false},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["ready", "leased", "blocked", "succeeded", "dead", "cancelled"]},
    "priority": {"type": "integer", "minimum": -100, "maximum": 100},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 8}
  },
  "additionalProperties": false
}
