{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "intent_id", "input_sha256", "input_bytes", "occurred_at", "accepted_at", "day", "time_origin"],
  "properties": {
    "schema_version": {"const": "breadcrumb-occurrence/v1"},
    "intent_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_bytes": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "minLength": 1},
    "accepted_at": {"type": "string", "minLength": 1},
    "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "time_origin": {"enum": ["host", "acceptance", "normalized_envelope"]}
  },
  "additionalProperties": false
}
