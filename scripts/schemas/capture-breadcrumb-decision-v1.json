{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/capture-breadcrumb-decision-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "intent_id",
    "intent_sha256",
    "complete_input_sha256",
    "chunk_sha256",
    "stage",
    "outcome",
    "operation_plan",
    "processing_binding",
    "renderer"
  ],
  "properties": {
    "schema_version": {
      "const": "capture-breadcrumb-decision/v1"
    },
    "intent_id": {
      "$ref": "#/$defs/digest"
    },
    "intent_sha256": {
      "$ref": "#/$defs/digest"
    },
    "complete_input_sha256": {
      "$ref": "#/$defs/digest"
    },
    "chunk_sha256": {
      "$ref": "#/$defs/digest"
    },
    "stage": {
      "const": "flush"
    },
    "outcome": {
      "const": "breadcrumb_written"
    },
    "operation_plan": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "block",
          "block_sha256",
          "operation_id",
          "chosen_at"
        ],
        "properties": {
          "kind": {
            "const": "append"
          },
          "path": {
            "type": "string",
            "pattern": "^knowledge/daily/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.md$",
            "maxLength": 64
          },
          "block": {
            "type": "string",
            "minLength": 1,
            "maxLength": 524288
          },
          "block_sha256": {
            "$ref": "#/$defs/digest"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "chosen_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "processing_binding": {
      "type": "object",
      "required": [
        "kind",
        "task_id",
        "active_link_digest"
      ],
      "properties": {
        "kind": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "active_link_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "renderer": {
      "const": "breadcrumb/v1"
    }
  },
  "additionalProperties": false
}
