{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "uv run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/integration_adapter.py\" --source cursor --event session_start",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "uv run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/integration_adapter.py\" --source cursor --event user_prompt",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "uv run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/integration_adapter.py\" --source cursor --event post_tool_use",
        "matcher": "Write|Shell",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "uv run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/integration_adapter.py\" --source cursor --event pre_compact",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "uv run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/integration_adapter.py\" --source cursor --event stop",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "uv run --locked --no-sync --directory \"__LLM_WIKI_ROOT__\" python \"__LLM_WIKI_ROOT__/scripts/integration_adapter.py\" --source cursor --event session_end",
        "timeout": 15
      }
    ]
  }
}
