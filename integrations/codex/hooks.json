{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync --directory \"$LLM_WIKI_ROOT\" python \"$LLM_WIKI_ROOT/scripts/codex_memory.py\" hook",
            "commandWindows": "uv run --locked --no-sync --directory \"%LLM_WIKI_ROOT%\" python \"%LLM_WIKI_ROOT%\\scripts\\codex_memory.py\" hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync --directory \"$LLM_WIKI_ROOT\" python \"$LLM_WIKI_ROOT/scripts/codex_memory.py\" hook",
            "commandWindows": "uv run --locked --no-sync --directory \"%LLM_WIKI_ROOT%\" python \"%LLM_WIKI_ROOT%\\scripts\\codex_memory.py\" hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync --directory \"$LLM_WIKI_ROOT\" python \"$LLM_WIKI_ROOT/scripts/codex_memory.py\" hook",
            "commandWindows": "uv run --locked --no-sync --directory \"%LLM_WIKI_ROOT%\" python \"%LLM_WIKI_ROOT%\\scripts\\codex_memory.py\" hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync --directory \"$LLM_WIKI_ROOT\" python \"$LLM_WIKI_ROOT/scripts/graph_hint.py\" --source codex",
            "commandWindows": "uv run --locked --no-sync --directory \"%LLM_WIKI_ROOT%\" python \"%LLM_WIKI_ROOT%\\scripts\\graph_hint.py\" --source codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync --directory \"$LLM_WIKI_ROOT\" python \"$LLM_WIKI_ROOT/scripts/graph_hint.py\" --source codex",
            "commandWindows": "uv run --locked --no-sync --directory \"%LLM_WIKI_ROOT%\" python \"%LLM_WIKI_ROOT%\\scripts\\graph_hint.py\" --source codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --no-sync --directory \"$LLM_WIKI_ROOT\" python \"$LLM_WIKI_ROOT/scripts/codex_memory.py\" hook",
            "commandWindows": "uv run --locked --no-sync --directory \"%LLM_WIKI_ROOT%\" python \"%LLM_WIKI_ROOT%\\scripts\\codex_memory.py\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
